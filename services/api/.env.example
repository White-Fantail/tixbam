DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/tixbam
TIXBAM_ADMIN_API_KEY=replace-with-long-random-secret
PORT=8000

# Required for signed user sessions (32+ random characters, distinct from admin/MCP keys).
TIXBAM_SESSION_SECRET=replace-with-32-or-more-cryptographically-random-characters

# OAuth callback base URL (public HTTPS domain on Railway).
# Register the two exact return URIs with the respective providers:
#   https://your-api.example/v1/auth/oauth/google/callback
#   https://your-api.example/v1/auth/oauth/apple/callback
TIXBAM_PUBLIC_URL=https://your-api.example
# Google Cloud Console: OAuth Web application credential
# TIXBAM_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# TIXBAM_GOOGLE_CLIENT_SECRET=xxxxx
# Apple Developer: Services ID + Sign in with Apple key (server-side only)
# TIXBAM_APPLE_CLIENT_ID=com.example.tixbam.signin
# TIXBAM_APPLE_TEAM_ID=YOUR_TEAM_ID
# TIXBAM_APPLE_KEY_ID=KEY_ID
# TIXBAM_APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"

# MCP stays disabled unless ALL of these are configured.
# An external OAuth 2.1 provider must support authorization code + PKCE, an
# audience for the MCP resource and the two scopes below. NEVER paste the
# TIXBAM_ADMIN_API_KEY or OAuth signing keys into ChatGPT.
# TIXBAM_MCP_RESOURCE_URL=https://tixbam-production.up.railway.app/mcp
# TIXBAM_MCP_OAUTH_ISSUER=https://YOUR-AUTH-DOMAIN/
# TIXBAM_MCP_OAUTH_JWKS_URL=https://YOUR-AUTH-DOMAIN/.well-known/jwks.json
# TIXBAM_MCP_OWNER_SUB=oauth-provider-specific-user-subject
