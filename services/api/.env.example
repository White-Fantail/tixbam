DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/tixbam
TIXBAM_ADMIN_API_KEY=replace-with-long-random-secret
PORT=8000

# MCP stays disabled unless ALL of these are configured.
# An external OAuth 2.1 provider must support authorization code + PKCE, an
# audience for the MCP resource and the two scopes below. NEVER paste the
# TIXBAM_ADMIN_API_KEY or OAuth signing keys into ChatGPT.
# TIXBAM_MCP_RESOURCE_URL=https://tixbam-production.up.railway.app/mcp
# TIXBAM_MCP_OAUTH_ISSUER=https://YOUR-AUTH-DOMAIN/
# TIXBAM_MCP_OAUTH_JWKS_URL=https://YOUR-AUTH-DOMAIN/.well-known/jwks.json
# TIXBAM_MCP_OWNER_SUB=oauth-provider-specific-user-subject
