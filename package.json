{
  "name": "tixbam",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "apps/desktop",
    "apps/admin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @tixbam/desktop",
    "dev:desktop": "npm run dev -w @tixbam/desktop",
    "dev:copilot": "npm run dev:copilot -w @tixbam/desktop",
    "dev:web": "npm run dev:web -w @tixbam/desktop",
    "dev:admin": "npm run dev -w @tixbam/admin",
    "test": "npm run test -w @tixbam/desktop",
    "test:copilot": "npm run test:copilot -w @tixbam/desktop",
    "test:nol": "npm run test:nol -w @tixbam/desktop",
    "test:ui:nol": "npm run test:ui:nol -w @tixbam/desktop",
    "verify:nol": "npm run verify:nol -w @tixbam/desktop",
    "check": "npm run check -w @tixbam/desktop",
    "build": "npm run build -w @tixbam/desktop && npm run build -w @tixbam/admin",
    "build:desktop": "npm run build -w @tixbam/desktop",
    "build:admin": "npm run build -w @tixbam/admin",
    "desktop": "npm run desktop -w @tixbam/desktop",
    "release:check": "node scripts/release-readiness.cjs"
  }
}
